# CloudMedRecord Frontend — Environment Variables
# Copy to .env.local and fill in real values.
# Variables must be prefixed with VITE_ to be accessible in client code.

# Backend API base URL. Vite's own `import.meta.env.DEV` covers the dev/prod
# distinction, so there is no separate environment variable for it.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Clerk Authentication (Get this from Clerk Dashboard)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
