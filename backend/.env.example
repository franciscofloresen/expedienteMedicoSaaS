# CloudMedRecord Backend — Environment Variables
# Copy to .env.local and fill in real values.

# Environment: development | staging | production
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Database (direct URL for development; Secrets Manager ARN for production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/cloudmedrecord
DB_SECRET_ARN=
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300

# Fase 8 ordered rollout (1=schema compatibility, 9=normative library)
CLINICAL_ROLLOUT_STAGE=9

# AWS KMS — leave empty for local dev (mock signing will be used)
KMS_ENCRYPTION_KEY_ID=
KMS_SIGNING_KEY_ID=

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_...

# S3 Buckets
S3_EXPEDIENTES_BUCKET=cloudmedrecord-expedientes-dev
S3_AUDIT_BUCKET=cloudmedrecord-audit-dev
S3_CONSENT_BUCKET=cloudmedrecord-consent-dev

# Cache TTLs (seconds)
SECRETS_CACHE_TTL=300
DEK_CACHE_TTL=300

# Local JWT Secret (development only)
# If empty, an ephemeral random secret is generated per process.
# Set this for persistent sessions across server restarts.
# SECURITY: NEVER commit real secrets. This value is for local dev only.
JWT_DEV_SECRET=

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:5173"]
