# CloudMedRecord Backend — Environment Variables
# Copy to .env.local and fill in real values.

# Environment: development | testing | prod
# These are the only three values the code recognises. Anything else is treated
# as production (fail-closed) but will NOT enable the prod-only hardening that
# checks for the literal "prod" — HSTS headers and the disabled /docs endpoint.
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Database (direct URL for development; Secrets Manager ARN for production)
# Host, port, user and database name match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/medrecord
DB_SECRET_ARN=
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300

# Fase 8 ordered rollout (1=schema compatibility, 9=normative library)
CLINICAL_ROLLOUT_STAGE=9

# AWS KMS — leave empty for local dev (mock signing will be used)
KMS_ENCRYPTION_KEY_ID=
KMS_SIGNING_KEY_ID=

# Clerk Authentication
# Local development only. Production receives APP_CONFIG_SECRET_ARN instead.
CLERK_SECRET_KEY=sk_test_...
APP_CONFIG_SECRET_ARN=
CLERK_ISSUER_URL=https://example.clerk.accounts.dev
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]
CLERK_AUDIENCE=
CLERK_REQUIRE_MFA=true
CLERK_REAUTH_MAX_AGE_MINUTES=10

# S3 Buckets — the `medrecord-` prefix matches Terraform and the code defaults.
S3_EXPEDIENTES_BUCKET=medrecord-expedientes-dev
S3_AUDIT_BUCKET=medrecord-audit-dev
S3_CONSENT_BUCKET=medrecord-consent-dev

# Cache TTLs (seconds)
SECRETS_CACHE_TTL=300

# Local JWT Secret (development only)
# If empty, an ephemeral random secret is generated per process.
# Set this for persistent sessions across server restarts.
# SECURITY: NEVER commit real secrets. This value is for local dev only.
JWT_DEV_SECRET=

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:5173"]
