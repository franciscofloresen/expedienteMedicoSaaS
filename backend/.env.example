# MedRecord Backend — Environment Variables
# Copy to .env.local and fill in real values.

# Environment: development | staging | production
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Database (direct URL for development; Secrets Manager ARN for production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/medrecord
DB_SECRET_ARN=

# AWS KMS — leave empty for local dev (mock signing will be used)
KMS_ENCRYPTION_KEY_ID=
KMS_SIGNING_KEY_ID=

# AWS Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# S3 Buckets
S3_EXPEDIENTES_BUCKET=medrecord-expedientes-dev
S3_AUDIT_BUCKET=medrecord-audit-dev
S3_CONSENT_BUCKET=medrecord-consent-dev

# Cache TTLs (seconds)
SECRETS_CACHE_TTL=300
DEK_CACHE_TTL=300

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:5173"]
