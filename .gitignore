*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Node ──
node_modules/
.next/
.nuxt/
.output/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Terraform ──
.terraform/
*.tfstate
*.tfstate.*
*.state
*.backup
*.tfplan
crash.log
override.tf
override.tf.json
