*_override.tf.json
.terraform.lock.hcl

# ── Environment ──
.env
.env.local
.env.*.local
*.pem
*.key

# ── Testing ──
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.mypy_cache/

# ── Build artifacts ──
*.zip
*.tar.gz
